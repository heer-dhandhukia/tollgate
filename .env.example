# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Postgres (tollgate ledger) ---
DATABASE_URL=postgresql+asyncpg://tollgate:tollgate@localhost:5432/tollgate

# --- Mock payment provider (separate service, separate database) ---
MOCKPAY_DATABASE_URL=postgresql+asyncpg://tollgate:tollgate@localhost:5432/mockpay
MOCKPAY_URL=http://localhost:8100
MOCKPAY_WEBHOOK_URL=http://localhost:8000/webhooks/mockpay
MOCKPAY_WEBHOOK_SECRET=change-me-local-only
# Refund settles (pending -> processed) after this many ms
MOCKPAY_SETTLE_DELAY_MS=200
# Random fault injection (0.0-1.0). Scripted faults use POST /_admin/faults instead.
MOCKPAY_FAULT_SEED=42
MOCKPAY_P_LATENCY=0.0
MOCKPAY_LATENCY_MS=0
MOCKPAY_P_ERROR_BEFORE_COMMIT=0.0
MOCKPAY_P_ERROR_AFTER_COMMIT=0.0
MOCKPAY_P_TIMEOUT_AFTER_COMMIT=0.0
MOCKPAY_TIMEOUT_HANG_MS=5000
MOCKPAY_P_DUPLICATE_WEBHOOK=0.0
MOCKPAY_P_OUT_OF_ORDER_WEBHOOKS=0.0

# --- LLM (used from phase A2) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
